<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded view: title, a hint, and a 2 x 3 grid of category tiles. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/notifTitle"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1" />

    <TextView
        android:id="@+id/notifSubtitle"
        style="@style/TextAppearance.Compat.Notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="Pick a category · the app remembers this payee" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/tile0"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginStart="0dp"
            android:background="@drawable/notif_tile_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="2dp">

            <ImageView
                android:id="@+id/icon0"
                android:layout_width="22dp"
                android:layout_height="22dp" />

            <TextView
                android:id="@+id/label0"
                style="@style/TextAppearance.Compat.Notification.Info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tile1"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/notif_tile_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="2dp">

            <ImageView
                android:id="@+id/icon1"
                android:layout_width="22dp"
                android:layout_height="22dp" />

            <TextView
                android:id="@+id/label1"
                style="@style/TextAppearance.Compat.Notification.Info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tile2"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/notif_tile_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="2dp">

            <ImageView
                android:id="@+id/icon2"
                android:layout_width="22dp"
                android:layout_height="22dp" />

            <TextView
                android:id="@+id/label2"
                style="@style/TextAppearance.Compat.Notification.Info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/tile3"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginStart="0dp"
            android:background="@drawable/notif_tile_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="2dp">

            <ImageView
                android:id="@+id/icon3"
                android:layout_width="22dp"
                android:layout_height="22dp" />

            <TextView
                android:id="@+id/label3"
                style="@style/TextAppearance.Compat.Notification.Info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tile4"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/notif_tile_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="2dp">

            <ImageView
                android:id="@+id/icon4"
                android:layout_width="22dp"
                android:layout_height="22dp" />

            <TextView
                android:id="@+id/label4"
                style="@style/TextAppearance.Compat.Notification.Info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tile5"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/notif_tile_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="2dp">

            <ImageView
                android:id="@+id/icon5"
                android:layout_width="22dp"
                android:layout_height="22dp" />

            <TextView
                android:id="@+id/label5"
                style="@style/TextAppearance.Compat.Notification.Info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
